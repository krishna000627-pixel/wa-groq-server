<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/aria_bg">
 <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_aria"/>
  <TextView android:text="Aria Reply" android:textSize="30sp" android:textStyle="bold" android:textColor="@android:color/white" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:text="Background WhatsApp notification assistant" android:textSize="16sp" android:textColor="#9BB3AA" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <Button android:id="@+id/enableAccess" android:text="Enable Notification Access" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Switch android:id="@+id/autoReply" android:text="Auto Reply" android:textColor="@android:color/white" android:textSize="18sp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/backendUrl" android:hint="Aria backend URL" android:text="https://wa-groq-server.onrender.com/webhook" android:textColor="@android:color/white" android:textColorHint="#789086" android:backgroundTint="#20E878" android:singleLine="true" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/prompt" android:hint="Reply instruction" android:text="Reply naturally and briefly. Match the sender's Hindi, Hinglish, or English." android:textColor="@android:color/white" android:textColorHint="#789086" android:backgroundTint="#20E878" android:minLines="3" android:gravity="top" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/delay" android:hint="Delay in seconds" android:inputType="number" android:text="2" android:textColor="@android:color/white" android:backgroundTint="#20E878" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/save" android:text="Save Settings" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="How it works\n\nAria reads incoming WhatsApp notifications and sends the message to your existing Aria backend for AI generation. If the notification exposes WhatsApp's supported Direct Reply action, Aria can send a reply through that action. No WhatsApp watermark is added by Aria.\n\nIf a notification does not expose a reply action, Android does not allow this app to send a background reply through that notification." android:textColor="#9BB3AA" android:textSize="15sp" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
</ScrollView>
